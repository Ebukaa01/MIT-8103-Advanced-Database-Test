// EquityPay Database Markup Language (DBML)
// For DBML Renderers (dbdocs.io, dbdiagram.io)

Table customers {
  customer_id bigint [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [unique, not null]
  phone varchar(20) [unique, not null]
  customer_type varchar(20) [not null, note: 'INDIVIDUAL | MERCHANT']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | SUSPENDED | CLOSED']
  created_at timestamptz [not null, default: `now()`]
}

Table kyc_records {
  kyc_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customers.customer_id]
  id_type varchar(30) [not null, note: 'NIN | BVN | PASSPORT | DRIVERS_LICENCE']
  id_number varchar(50) [not null]
  verification_status varchar(20) [not null, default: 'PENDING', note: 'PENDING | VERIFIED | REJECTED']
  submitted_at timestamptz [not null, default: `now()`]
  verified_at timestamptz [null]
}

Table accounts {
  account_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customers.customer_id]
  account_number char(10) [unique, not null, note: '10-digit NUBAN regex']
  currency char(3) [not null, default: 'NGN']
  balance numeric(19,4) [not null, default: 0, note: 'balance >= 0']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | FROZEN | CLOSED']
  opened_at timestamptz [not null, default: `now()`]
}

Table beneficiaries {
  beneficiary_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customers.customer_id]
  bank_name varchar(100) [not null]
  account_number char(10) [not null, note: '10-digit NUBAN']
  account_name varchar(150) [not null]

  indexes {
    (customer_id, bank_name, account_number) [unique]
  }
}

Table cards {
  card_id bigint [pk, increment]
  account_id bigint [not null, ref: > accounts.account_id]
  last_four char(4) [not null, note: '4-digit regex, PCI-DSS compliant']
  card_type varchar(20) [not null, note: 'DEBIT | VIRTUAL']
  expiry_date date [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | BLOCKED | EXPIRED']
}

Table transactions {
  transaction_id bigint [pk, increment]
  idempotency_key varchar(64) [unique, not null]
  txn_type varchar(20) [not null, note: 'DEPOSIT | WITHDRAWAL | TRANSFER | BILL_PAYMENT | REVERSAL']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | COMPLETED | FAILED | REVERSED']
  amount numeric(19,4) [not null, note: 'amount > 0']
  reference varchar(100) [null]
  reversal_of bigint [null, ref: - transactions.transaction_id]
  initiated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz [null]
}

Table ledger_entries {
  entry_id bigint [pk, increment]
  transaction_id bigint [not null, ref: > transactions.transaction_id]
  account_id bigint [not null, ref: > accounts.account_id]
  direction varchar(6) [not null, note: 'DEBIT | CREDIT']
  amount numeric(19,4) [not null, note: 'amount > 0']
  balance_after numeric(19,4) [not null, note: 'balance_after >= 0']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (transaction_id, account_id, direction) [unique]
  }
}

Table fraud_flags {
  flag_id bigint [pk, increment]
  transaction_id bigint [not null, ref: > transactions.transaction_id]
  reason varchar(200) [not null]
  risk_score smallint [not null, note: '0 to 100']
  status varchar(20) [not null, default: 'OPEN', note: 'OPEN | UNDER_REVIEW | CLEARED | CONFIRMED']
  flagged_at timestamptz [not null, default: `now()`]
}
