# EquityPay PostgreSQL Distributed Cluster Configuration
POSTGRES_DB=equitypay_db
POSTGRES_USER=equitypay
POSTGRES_PASSWORD=equitypay_pass

# Dedicated Streaming Replication Credentials
REPLICA_USER=replicator
REPLICATION_PASSWORD=replica_secure_pass

# Host Port Mappings
PRIMARY_PORT=5433
REPLICA_PORT=5434

# Connection Strings
PRIMARY=postgresql://equitypay:equitypay_pass@localhost:5433/equitypay_db
REPLICA=postgresql://equitypay:equitypay_pass@localhost:5434/equitypay_db
